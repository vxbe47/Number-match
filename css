* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    background-color: #2d8a4e;
    min-height: 100vh;
    color: #1a3c2a;
}

.container {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.header {
    text-align: center;
    margin-bottom: 20px;
}

.header h1 {
    font-size: 2.5rem;
    font-weight: 800;
    color: #ffffff;
}

.subtitle {
    color: #d4edda;
    font-size: 1rem;
    margin-top: 4px;
}

.stats-bar {
    display: flex;
    gap: 20px;
    margin-bottom: 20px;
    background-color: #ffffff;
    border: 2px solid #d4edda;
    border-radius: 16px;
    padding: 12px 24px;
}

.stat {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 1.1rem;
    font-weight: 600;
}

.stat-label {
    color: #5a7d6a;
}

.stat-value {
    color: #2d8a4e;
    font-weight: 800;
}

.stat-separator {
    color: #5a7d6a;
}

.setup-panel {
    background-color: #ffffff;
    border: 2px solid #d4edda;
    border-radius: 24px;
    padding: 32px;
    margin-bottom: 24px;
    text-align: center;
    width: 100%;
    max-width: 450px;
}

.setup-panel h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 20px;
    color: #1a3c2a;
}

.grid-options {
    display: flex;
    gap: 12px;
}

.grid-option {
    flex: 1;
    cursor: pointer;
}

.grid-option input[type="radio"] {
    display: none;
}

.grid-option-label {
    display: block;
    padding: 14px;
    border: 2px solid #d4edda;
    border-radius: 12px;
    font-size: 1.2rem;
    font-weight: 700;
    text-align: center;
    background-color: #ffffff;
    transition: all 0.2s ease;
    color: #1a3c2a;
}

.grid-option input[type="radio"]:checked + .grid-option-label {
    background-color: #2d8a4e;
    color: #ffffff;
    border-color: #2d8a4e;
}

.grid-option-label:hover {
    border-color: #2d8a4e;
    background-color: #f0f7f4;
}

.action-buttons {
    display: flex;
    gap: 12px;
    margin-bottom: 20px;
}

.btn {
    padding: 12px 28px;
    font-size: 1rem;
    font-weight: 700;
    border: none;
    border-radius: 14px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-primary {
    background-color: #c0392b;
    color: #ffffff;
}

.btn-primary:hover {
    background-color: #a93226;
}

.btn-outline {
    background-color: #ffffff;
    color: #1a3c2a;
    border: 2px solid #d4edda;
}

.btn-outline:hover {
    border-color: #2d8a4e;
    background-color: #f0f7f4;
}

.reset-btn {
    margin-top: 20px;
}

.game-board {
    display: grid;
    gap: 8px;
    justify-content: center;
}

.game-board.grid-2x2 {
    grid-template-columns: repeat(2, 100px);
}

.game-board.grid-4x4 {
    grid-template-columns: repeat(4, 90px);
}

.game-board.grid-6x4 {
    grid-template-columns: repeat(4, 75px);
}

.card {
    aspect-ratio: 3 / 4;
    perspective: 800px;
    cursor: pointer;
}

.card.matched {
    cursor: default;
}

.card-inner {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.5s ease;
    border-radius: 8px;
}

.card.flipped .card-inner,
.card.matched .card-inner {
    transform: rotateY(180deg);
}

.card.matched .card-inner {
    box-shadow: 0 0 0 4px #f1c40f, 0 0 12px rgba(241, 196, 15, 0.5);
    border-radius: 8px;
}

.card-front,
.card-back {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    border-radius: 8px;
    overflow: hidden;
}

.card-back {
    z-index: 2;
}

.card-back img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 8px;
}

.card-front {
    transform: rotateY(180deg);
    background-color: #ffffff;
    border: 2px solid #dddddd;
    display: flex;
    align-items: center;
    justify-content: center;
}

.card.matched .card-front {
    background-color: #fef9e7;
    border-color: #f1c40f;
}

.card-front img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 4px;
}

.overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.6);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 100;
}

.alert-box,
.win-box {
    background-color: #ffffff;
    border-radius: 24px;
    padding: 40px;
    max-width: 380px;
    width: 90%;
    text-align: center;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
}

.alert-icon {
    font-size: 3rem;
    margin-bottom: 12px;
}

.alert-box h3,
.win-box h2 {
    font-size: 1.6rem;
    font-weight: 800;
    margin-bottom: 8px;
    color: #1a3c2a;
}

.alert-box p,
.win-box p {
    color: #5a7d6a;
    margin-bottom: 24px;
    font-size: 1rem;
}

.alert-box .btn,
.win-box .btn {
    width: 100%;
}

.trophy {
    font-size: 4rem;
    margin-bottom: 12px;
}

.win-box h2 {
    font-size: 2rem;
}
